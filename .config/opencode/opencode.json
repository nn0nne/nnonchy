{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@franlol/opencode-md-table-formatter@0.0.3",
    "@tarquinen/opencode-dcp@latest",
    "opencode-pty",
    "opencode-vibeguard"
  ],
  "default_agent": "plan",
  "mcp": {
    "grepai": {
      "type": "local",
      "command": [
        "grepai",
        "mcp-serve"
      ],
      "enabled": true
    },
    "mgrep": {
      "type": "local",
      "command": [
        "mgrep",
        "mcp"
      ],
      "enabled": true
    }
  },
}
