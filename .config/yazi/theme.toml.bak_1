# vim:fileencoding=utf-8:foldmethod=marker

# : Manager {{{

[mgr]
cwd = { fg = "#8ba9c1" } # soft blue for current path

# Hovered item
hovered = { fg = "#141415", bg = "#8ba9c1" } # white-on-blue
preview_hovered = { underline = true }

# Find
find_keyword = { fg = "#99b782", italic = true }  # soft green
find_position = { fg = "#f5cb96", italic = true } # warm yellow

# Marker (selection)
marker_selected = { fg = "#141415", bg = "#bb9dbd" } # magenta
marker_copied = { fg = "#141415", bg = "#99b782" }   # green
marker_cut = { fg = "#141415", bg = "#e08398" }      # pink/red

# Tab
tab_active = { fg = "#141415", bg = "#8ba9c1" }   # soft blue
tab_inactive = { fg = "#606079", bg = "#252530" } # dim on surface

tab_width = 1

# Border
border_symbol = "│"
border_style = { fg = "#606079" } # dim gray-blue

# Highlighting
# syntect_theme = "~/.config/yazi/vague.tmTheme"  # optional syntax theme

# : }}}


# : Status {{{

[status]
separator_open = ""
separator_close = ""
separator_style = { fg = "#252530", bg = "#252530" }

# Progress
progress_label = { fg = "#cdcdcd", bold = true }
progress_normal = { fg = "#8ba9c1", bg = "#252530" }
progress_error = { fg = "#e08398", bg = "#252530" }

# Permissions
permissions_t = { fg = "#606079" } # type (dim)
permissions_r = { fg = "#99b782" } # read (green)
permissions_w = { fg = "#e08398" } # write (pink)
permissions_x = { fg = "#8ba9c1" } # exec (blue)
permissions_s = { fg = "#606079" } # special (dim)

# : }}}


# : Mode {{{

[mode]
normal_main = { fg = "#141415", bg = "#8ba9c1", bold = true } # blue
normal_alt = { fg = "#141415", bg = "#8ba9c1", bold = true }

select_main = { fg = "#141415", bg = "#bb9dbd", bold = true } # magenta
select_alt = { fg = "#141415", bg = "#bb9dbd", bold = true }

unset_main = { fg = "#141415", bg = "#e08398", bold = true } # pink
unset_alt = { fg = "#141415", bg = "#e08398", bold = true }

# : }}}


# : Input {{{

[input]
border = { fg = "#c9b1ca" }    # bright magenta
title = {}
value = {}
selected = { reversed = true }

# : }}}


# : Select {{{

[select]
border = { fg = "#606079" }
active = { fg = "#f5cb96" } # warm yellow
inactive = {}

# : }}}


# : Tasks {{{

[tasks]
border = { fg = "#606079" }
title = {}
hovered = { underline = true }

# : }}}


# : Which {{{

[which]
mask = { bg = "#252530" }
cand = { fg = "#8ba9c1" }            # suggestions
rest = { fg = "#606079" }            # dim rest
desc = { fg = "#f5cb96" }            # description (yellow)
separator = "  "
separator_style = { fg = "#606079" }

# : }}}


# : Help {{{

[help]
on = { fg = "#f5cb96" }                     # key names
exec = { fg = "#8ba9c1" }                   # commands
desc = { fg = "#606079" }                   # descriptions
hovered = { bg = "#252530", bold = true }
footer = { fg = "#141415", bg = "#8ba9c1" }

# : }}}


# : File-specific styles {{{

[filetype]

rules = [
  # Images
  { mime = "image/*", fg = "#8ba9c1" }, # soft blue

  # Videos & Audio
  { mime = "video/*", fg = "#99b782" }, # soft green
  { mime = "audio/*", fg = "#99b782" },

  # Archives
  { mime = "application/zip", fg = "#f5cb96" },
  { mime = "application/gzip", fg = "#f5cb96" },
  { mime = "application/x-tar", fg = "#f5cb96" },
  { mime = "application/x-bzip*", fg = "#f5cb96" },
  { mime = "application/x-7z-compressed", fg = "#f5cb96" },
  { mime = "application/x-rar", fg = "#f5cb96" },

  # Fallback
  { name = "*", fg = "#cdcdcd" },  # default text
  { name = "*/", fg = "#8ba9c1" }, # directories → blue
]

# : }}}
