[
    {
        "height": 25,
        "spacing": 4,
        "passthrough": false,
        "output": "eDP-1",
        "gtk-layer-shell": true,
        "ipc": false,
        "layer": "top",
        "position": "top",
        "reload_style_on_change": true,
        "modules-left": [
            "clock",
            "dwl/tags",
            "custom/window-counter",
            "dwl/window"
        ],
        "modules-center": [],
        "modules-right": [
            "group/tray",
            "idle_inhibitor",
            "temperature",
            "cpu",
            "memory",
            "pulseaudio",
            "backlight",
            "privacy",
            "bluetooth",
            "network",
            "power-profiles-daemon",
            "battery"
        ],
        "custom/window-counter": {
            "exec": "stdbuf -oL ~/.config/waybar/scripts/scrolling-window-list.sh",
            "return-type": "json",
            "format": "{}",
            "escape": true,
            "tooltip-format": "{}"
        },
        "wlr/taskbar": {
            "format": "{icon}",
            "icon-size": 14,
            "tooltip-format": "{title}"
        },
        "idle_inhibitor": {
            "format": "{icon}",
            "format-icons": {
                "activated": "",
                "deactivated": ""
            }
        },
        "systemd-failed-units": {
            "format": "  <span color='#d8647e'>✗</span> {nr_failed}"
        },
        "privacy": {
            "icon-spacing": 2,
            "icon-size": 14,
            "modules": [
                {
                    "type": "screenshare",
                    "tooltip": true,
                    "tooltip-icon-size": 14
                },
                {
                    "type": "audio-out",
                    "tooltip": true,
                    "tooltip-icon-size": 14
                },
                {
                    "type": "audio-in",
                    "tooltip": true,
                    "tooltip-icon-size": 14
                }
            ]
        },
        "network": {
            "interface": "wlan0",
            "format": "{icon}",
            "format-wifi": "󰖩",
            "format-disconnected": "",
            "tooltip-format-wifi": "{essid} ({signalStrength}%) 󰖩",
            "on-click": "foot impala"
        },
        "bluetooth": {
            "format": "",
            "format-connected": "",
            "format-on": "",
            "tooltip": true,
            "tooltip-format-connected": "{device_alias} - {device_battery_percentage}%",
            "on-click": "foot bluetui"
        },
        "temperature": {
            "interval": 30,
            "critical-threshold": 50,
            "warning-threshold": 60,
            "format": "{temperatureC}°C"
        },
        "memory": {
            "interval": 30,
            "format": "{percentage}%   {swapPercentage}% 󰓡",
            "tooltip": true,
            "tooltip-format": "{used:0.1f}GiB   {swapUsed:0.1f}GiB 󰓡"
        },
        "cpu": {
            "interval": 30,
            "format": "{usage}% ",
            "on-click": "foot -e htop"
        },
        "disk": {
            "format": "{percentage_used}% {path}",
            "path": "/"
        },
        "backlight": {
            "device": "intel_backlight",
            "format": "{icon}",
            "format-icons": [
                "",
                "",
                "",
                "",
                "",
                "",
                "",
                "",
                ""
            ],
            "tooltip": true,
            "tooltip-format": "{icon} {percent}%",
            "interval": 1
        },
        "ext/workspaces": {
            "format": "{icon}",
            "ignore-hidden": true,
            "on-click": "activate",
            "sort-by-id": true
        },
        "dwl/tags": {
            "num-tags": 9,
            "disable-click": false,
            "tag-labels": [
                "一",
                "二",
                "三",
                "四",
                "五",
                "六",
                "七",
                "八",
                "九"
            ]
        },
        "dwl/window": {
            "format": "[{layout}] {app_id}",
            "rewrite": {
                "^\\[(.*)\\] brave-browser$": "[$1] Brave",
                "^\\[(.*)\\] thunar$": "[$1] Thunar",
                "^\\[(.*)\\] vesktop$": "[$1] Vesktop",
                "^\\[(.*)\\] blueman-manager$": "[$1] Bluetooh Manager",
                "^\\[(.*)\\] com.github.wwmm.easyeffects$": "[$1] Easy Effects",
                "^\\[(.*)\\] localsend$": "[$1] LocalSend",
                "^\\[(.*)\\] org.gnome.gThumb$": "[$1] GThumb",
                "^\\[(.*)\\] com.obsproject.Studio$": "[$1] OBS Studio",
                "^\\[(.*)\\] .*cinhimbnkkaeohfgghhklpknlkffjgod.*$": "[$1] Youtube Music",
                "^\\[(.*)\\] .*agimnkijcaahngcdmfeangaknmldooml.*$": "[$1] Youtube",
                "^\\[(.*)\\] .*eikjhbkpemdappjfcmdeeeamdpkgabmk.*$": "[$1] Soundcloud",
                "^\\[(.*)\\] .*hnpfjngllnobngcgfapefoaidbinmjnm.*$": "[$1] Whatsapp",
                "^\\[(.*)\\] .*ibblmnobmgdmpoeblocemifbpglakpoi.*$": "[$1] Telegram",
                "^\\[(.*)\\] .*pjibgclleladliembfgfagdaldikeohf.*$": "[$1] Spotify"
            }
        },
        "clock": {
            "format": "{:%A %H:%M, %Y-%m-%d}",
            "tooltip-format": "<tt><small>{calendar}</small></tt>",
            "calendar": {
                "mode": "year",
                "mode-mon-col": 3,
                "weeks-pos": "right",
                "format": {
                    "months": "<span color='#bb9dbd'><b>{}</b></span>",
                    "weeks": "<span color='#6e94b2'><b>W{}</b></span>",
                    "days": "<span color='#cdcdcd'><b>{}</b></span>",
                    "weekdays": "<span color='#7fa563'><b>{}</b></span>",
                    "today": "<span color='#f3be7c'><b><u>{}</u></b></span>"
                }
            },
            "actions": {
                "on-click-right": "mode",
                "on-scroll-up": "shift_up",
                "on-scroll-down": "shift_down"
            }
        },
        "group/tray": {
            "orientation": "horizontal",
            "drawer": {
                "transition-duration": 200,
                "children-class": "tray-child",
                "click-to-reveal": true
            },
            "modules": [
                "custom/tray-toggle",
                "tray"
            ]
        },
        "custom/tray-toggle": {
            "format": "",
            "tooltip": false
        },
        "tray": {
            "icon-size": 15,
            "spacing": 6
        },
        "pulseaudio": {
            "format": "{icon}",
            "format-muted": " ",
            "format-icons": [
                "▁",
                "▂",
                "▃",
                "▄",
                "▅",
                "▆",
                "▇"
            ],
            "on-click": "foot -e wiremix",
            "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
            "tooltip": true,
            "tooltip-format": "{icon} {volume}%",
            "max-volume": 100
        },
        "battery": {
            "states": {
                "warning": 30,
                "critical": 15
            },
            "format": "{capacity}% {icon}",
            "format-icons": {
                "default": [
                    "󰂎",
                    "󰁺",
                    "󰁻",
                    "󰁼",
                    "󰁽",
                    "󰁾",
                    "󰁿",
                    "󰂀",
                    "󰂁",
                    "󰂂",
                    "󰁹"
                ],
                "charging": [
                    "󰢟",
                    "󰢜",
                    "󰂆",
                    "󰂇",
                    "󰂈",
                    "󰢝",
                    "󰂉",
                    "󰢞",
                    "󰂊",
                    "󰂋",
                    "󰂅"
                ]
            },
            "tooltip": true,
            "tooltip-format": "{timeTo}"
        },
        "power-profiles-daemon": {
            "format": "{icon}",
            "format-icons": {
                "performance": "",
                "balanced": "",
                "power-saver": ""
            },
            "tooltip": true,
            "tooltip-format": "{profile}\n{driver}"
        }
    }
]
