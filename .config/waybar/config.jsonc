{
  "height": 30,
  "spacing": 10,
  "mode": "dock",
  "layer": "top",

  "modules-left": ["clock", "ext/workspaces", "dwl/window"],
  "modules-center": ["mpris"],
  "modules-right": [
    "group/tray",
    "temperature",
    "cpu",
    "memory",
    // "disk",
    "pulseaudio",
    "backlight",
    "battery",
    "power-profiles-daemon"
  ],

  // --- Modules ---

  "mpris": {
	"format": "{player_icon} {artist} - {title}",
	"format-paused": "{status_icon} <i>{artist} - {title}</i>",
	"player-icons": {
		"default": "▶"
	},
	"status-icons": {
		"paused": "⏸"
	},
    "on-click": "playerctl previous",
    "on-click-right": "playerctl next"
  },

  "temperature": {
    // "thermal-zone": 2,
    // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
    // "critical-threshold": 80,
    // "format-critical": "{temperatureC}°C ",
    "format": "{temperatureC}°C"
  },
  "memory": {
    "interval": 30,
    "format": "{percentage}%   {swapPercentage}% 󰓡",
    "max-length": 15
  },

  "cpu": {
    "interval": 10,
    "format": "{usage}% ",
    "max-length": 10
  },

  "disk": {
    "interval": 30,
    "format": "{percentage_used}% {path}",
    "path": "/"
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "{icon}",
    "format-icons": ["", "", "", "", "", "", "", "", ""]
  },

  "ext/workspaces": {
    "format": "{icon}",
    "ignore-hidden": true,
    "on-click": "activate",
    "sort-by-id": true
  },

  "dwl/window": {
    "format": "[{layout}] {app_id}",
    "rewrite": {
      "^\\[(.*)\\] .*cinhimbnkkaeohfgghhklpknlkffjgod.*$": "[$1] Youtube Music",
      "^\\[(.*)\\] .*agimnkijcaahngcdmfeangaknmldooml.*$": "[$1] Youtube",
      "^\\[(.*)\\] .*eikjhbkpemdappjfcmdeeeamdpkgabmk.*$": "[$1] Soundcloud",
      "^\\[(.*)\\] .*hnpfjngllnobngcgfapefoaidbinmjnm.*$": "[$1] Whatsapp",
      "^\\[(.*)\\] .*ibblmnobmgdmpoeblocemifbpglakpoi.*$": "[$1] Telegram",
      "^\\[(.*)\\] .*pjibgclleladliembfgfagdaldikeohf.*$": "[$1] Spotify"
    }
  },

  "clock": {
    "format": "{:%H:%M, %Y-%m-%d}",
    // "timezone": "America/New_York",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  "group/tray": {
  "orientation": "horizontal",
  "drawer": {
    "transition-duration": 200,
    "children-class": "tray-child",
    "click-to-reveal": true
  },
  "modules": [
    "custom/tray-toggle",
    "tray"
  ]
},

"custom/tray-toggle": {
  "format": "",  
  "tooltip": false
},

"tray": {
  "icon-size": 15,
  "spacing": 6
},

  "pulseaudio": {
    // "format": "{volume}% <span font='12'>{icon}</span>",
    "format": "{icon}",
    "format-muted": " ",
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇"],
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "tooltip": false
  },

  "battery": {
    "states": {
      "warning": 25,
      "critical": 15
    },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% 󰂄",
    "format-plugged": "{capacity}% ",
    "format-icons": ["", "", "", "", ""],
    "tooltip": false
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "format-icons": {
      "performance": "",
      "balanced": "",
      "power-saver": ""
    },
    "tooltip": false
  }
}
