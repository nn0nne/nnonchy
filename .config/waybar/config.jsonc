{
  "height": 30,
  "spacing": 4,

  "modules-left": ["ext/workspaces", "dwl/window"],
  "modules-center": ["clock"],
  "modules-right": [
    "tray",
    "temperature",
    "pulseaudio",
    "battery",
    "power-profiles-daemon",
  ],

  // --- Modules ---
  "ext/workspaces": {
    "format": "{icon}",
    "ignore-hidden": true,
    "on-click": "activate",
    "sort-by-id": true,
  },

  "dwl/window": {
    "format": "[{layout}] {title}",
  },

  "clock": {
    "format": "{:%H:%M, %Y-%m-%d}",
    // "timezone": "America/New_York",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>",
      },
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "tz_up",
      "on-scroll-down": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
    },
  },

  "tray": {
    "icon-size": 18,
    "spacing": 8,
  },

  "pulseaudio": {
    "format": "{volume}% <span font='12'>{icon}</span>",
    "format-muted": "<span font='12'></span>",
    "format-icons": {
      "default": ["", ""],
    },
    "on-click": "pavucontrol",
    "tooltip": false,
  },

  "battery": {
    "states": {
      "warning": 25,
      "critical": 15,
    },
    "format": "{capacity}% <span font='12'>{icon}</span>",
    "format-charging": "<span font='12'>󰂄</span>",
    "format-plugged": "<span font='12'></span>",
    "format-icons": ["", "", "", "", ""],
    "tooltip": false,
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "format-icons": {
      "performance": "<span font='12'></span>",
      "balanced": "<span font='12'></span>",
      "power-saver": "<span font='12'></span>",
    },
    "tooltip": false,
  },
}
