# nnonne's custom config
# border style
default_border pixel 3
default_floating_border pixel 3

# hiding adjacent borders
hide_edge_borders smart_no_gaps

# no_focus when app opens
no_focus [window_role="pop-up"]


# focus follows mouse
focus_follows_mouse no

# mouse warping 
mouse_warping output

# popup during fullscreen behavior
popup_during_fullscreen smart

# focus wrappping
focus_wrapping no

# gaps
gaps inner 5
gaps outer 0
smart_gaps on

# startup apps
exec --no-startup-id easyeffects --gapplication-service
exec --no-startup-id fcitx -d
exec_always feh --bg-scale ~/.config/i3/wallpaper.png
exec_always --no-startup-id killall polybar
exec_always --no-startup-id ~/.config/polybar/launch_polybar.sh
exec_always --no-startup-id /usr/bin/autotiling
exec --no-startup-id xrandr -r 60
exec --no-startup-id picom &
exec --no-startup-id /usr/bin/lxpolkit &

# lockscreen
bindsym $mod+Shift+Control+l exec ~/.config/scripts/lock.sh

# screenshots
# Selection to clipboard
bindsym --release Shift+Print exec --no-startup-id maim -s -u | xclip -selection clipboard -t image/png
# Active window to clipboard
bindsym --release $mod+Print exec --no-startup-id maim -i $(xdotool getactivewindow) | xclip -sel clip -t image/png
# Selection to a dated file in ~/Pictures
bindsym --release Control+Shift+Print exec --no-startup-id maim -s -u ~/Pictures/Screenshots/screenshot-$(date +%Y%m%d-%H%M%SZ).png

# Dimming
bindsym $mod+F1 exec --no-startup-id xrandr --output eDP-1 --brightness 0.5
bindsym $mod+F2 exec --no-startup-id xrandr --output eDP-1 --brightness 1.0

# udiskie usb flashdrive recognition
exec --no-startup-id udiskie -t

# Media player controls via TWS
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev mode "TWS Mode"
bindsym XF86AudioPlay exec --no-startup-id playerctl play
bindsym XF86AudioPause exec --no-startup-id playerctl pause

# TWS Mode
mode "TWS Mode" {
    bindsym XF86AudioNext exec --no-startup-id playerctl previous, mode "default"
    bindsym XF86AudioPlay exec --no-startup-id ~/.config/scripts/bluetooth/toggle-bluetooth.sh, mode "default"
    bindsym XF86AudioPause exec --no-startup-id ~/.config/scripts/bluetooth/toggle-bluetooth.sh, mode "default"
    bindsym XF86AudioPrev mode "default"
}

bindsym $mod+grave exec --no-startup-id ~/.config/scripts/bluetooth/toggle-bluetooth.sh

exec --no-startup-id xset s off && xset s 0 0
exec --no-startup-id xset dpms 0 0 300
exec --no-startup-id xautolock -time 15 -locker "systemctl suspend" -detectsleep 

# system modes
set $Locker ~/.config/scripts/lock.sh && sleep 1

set $mode_system System (l) lock, (e) logout, (s) suspend, (h) hibernate, (r) reboot, (Shift+s) shutdown
mode "$mode_system" {
    bindsym l exec --no-startup-id $Locker, mode "default"
    bindsym e exec --no-startup-id i3-msg exit, mode "default"
    bindsym s exec --no-startup-id $Locker && systemctl suspend, mode "default"
    bindsym h exec --no-startup-id sudo systemctl hibernate, mode "default"
    bindsym r exec --no-startup-id systemctl reboot, mode "default"
    bindsym Shift+s exec --no-startup-id systemctl poweroff -i, mode "default"

    # back to normal: Enter or Escape
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

bindsym $mod+Delete mode "$mode_system"

## Scratchpad setup
# Make the currently focused window a scratchpad
bindsym $mod+Shift+minus move scratchpad
# Show the first scratchpad window
bindsym $mod+minus scratchpad show

# class                 border  backgr. text    indicator child_border
client.focused          #8ba4b0 #8ba4b0 #393B44 #8ba4b0  #8ba4b0
client.focused_inactive #393B44 #393B44 #C5C9C7 #393B44  #393B44
client.unfocused        #393B44 #393B44 #A4A7A4 #393B44  #393B44
client.urgent           #e46876 #e46876 #C5C9C7 #e46876  #e46876
client.placeholder      #0D0C0C #0D0C0C #A4A7A4 #0D0C0C  #0D0C0C

client.background       #090E13

# end config, anything below this are from i3

# i3 config file (v4)
#
# Please see https://i3wm.org/docs/userguide.html for a complete reference!

set $mod Mod4

font pango:JetBrainsMono Nerd Font 9

# Start XDG autostart .desktop files using dex. See also
# https://wiki.archlinux.org/index.php/XDG_Autostart
exec --no-startup-id dex --autostart --environment i3

# xss-lock grabs a logind suspend inhibit lock and will use i3lock to lock the
# screen before suspend. Use loginctl lock-session to lock your screen.
exec --no-startup-id xss-lock -- ~/.config/scripts/lock.sh -n

# NetworkManager is the most popular way to manage wireless networks on Linux,
# and nm-applet is a desktop environment-independent system tray GUI for it.
exec --no-startup-id nm-applet

# Use pactl to adjust volume in PulseAudio.
set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +1% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -1% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +1%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 1%-

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# move tiling windows via drag & drop by left-clicking into the title bar,
# or left-clicking anywhere into the window while holding the floating modifier.
tiling_drag modifier titlebar

# start a terminal
bindsym $mod+Return exec i3-sensible-terminal

# kill focused window
bindsym $mod+Shift+q kill

# start dmenu (a program launcher)
bindsym $mod+d exec --no-startup-id rofi -show drun

# change focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# split in horizontal orientation
# bindsym $mod+h split h

# split in vertical orientation
# bindsym $mod+v split v

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# focus the parent container
# bindsym $mod+a focus parent

# focus the child container
