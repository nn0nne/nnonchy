set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"


# assigning app to workspaces
assign [class="Brave-browser" instance="crx_hnpfjngllnobngcgfapefoaidbinmjnm"] number $ws2 # Whatsapp PWA
assign [class="Brave-browser" instance="crx_ibblmnobmgdmpoeblocemifbpglakpoi"] number $ws2 # Telegram PWA
assign [class="vesktop"] number $ws2
assign [class="zoom"] number $ws3
assign [class="Brave-browser" instance="crx_agimnkijcaahngcdmfeangaknmldooml"] number $ws4 # Youtube PWA
assign [class="Brave-browser" instance="crx_pjibgclleladliembfgfagdaldikeohf"] number $ws4 # Spotify PWA
assign [class="Brave-browser" instance="crx_cinhimbnkkaeohfgghhklpknlkffjgod"] number $ws4 # Youtube Music PWA
assign [class="zen"] number $ws5 
assign [class="winboat"] number $ws9
